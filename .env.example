# Optional server-only key for the opt-in LLM diagnosis layer.
# The deterministic harness and every reported deterministic result run without it.
OPENAI_API_KEY=

# Diagnosis model used only when a command is run with --llm.
SEQUENCER_MODEL=gpt-5.4-mini

# Razorpay connector: Test Mode and shadow decisions only.
# Keep every value server-only; never prefix it with NEXT_PUBLIC_, commit real values,
# reuse Live Mode credentials, or point this project at production traffic.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional local directory for verified webhook fixture capture. Serverless filesystems
# are ephemeral, so this is a development aid rather than durable storage.
RAZORPAY_CAPTURE_DIR=

# Durable webhook receipts and the mock action queue. Use a dedicated disposable or
# non-production Postgres/Neon database, then apply `npm run db:migrate` once.
DATABASE_URL=

# Required explicit safety assertion for webhook storage, the runner, and migrations.
# The feature also refuses Vercel production and non-Vercel NODE_ENV=production runtimes.
TEST_MODE_DATABASE=confirmed-non-production

# Protects GET/POST /api/test-mode/actions/run. Generate a long random server-only value,
# for example with: openssl rand -hex 32
CRON_SECRET=

# Required fail-closed gate for the executor. "mock" is the only supported value.
TEST_MODE_EXECUTOR=mock
