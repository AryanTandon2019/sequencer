# Only needed once the LLM diagnosis layer exists.
#
# The full harness runs and reproduces every reported number WITHOUT this key,
# using the deterministic diagnoser. That is deliberate: a reviewer must be able
# to verify the results with `npm install && npm run harness` and nothing else.
OPENAI_API_KEY=

# Diagnosis model. Kept small on purpose - the model only sees the minority of
# failures that deterministic rules cannot classify.
SEQUENCER_MODEL=gpt-5.4-mini

# Razorpay connector. Test Mode and shadow decisions only.
# Never commit real values or reuse these variables for Live Mode credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
